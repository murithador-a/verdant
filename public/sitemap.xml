<?xml version="1.0" encoding="UTF-8"?>
<!--
  Verdant Clean sitemap.

  This site is a single page: every section is reached through a fragment
  (#plans, #journal, #faq, ...). Google strips fragment identifiers and does
  not treat `/#section` as a distinct document, so the previous version of
  this file advertised 11 <loc> entries for only 8 distinct URLs (#services
  was listed three times, #about twice) and 10 of them collapsed onto the home
  page anyway. A sitemap like that reads as duplicate-URL noise in Search
  Console and wastes crawl budget without describing the site.

  It now declares the one crawlable document, with the images that should be
  indexed against it. If the journal ever graduates from its modal reader to
  real routes (see the `#article-N` permalinks used in feed.xml), add those
  URLs here as separate entries.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
>
  <url>
    <loc>https://verdantclean.ng/</loc>
    <lastmod>2026-09-20</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>

    <image:image>
      <image:loc>https://verdantclean.ng/images/hero.jpg</image:loc>
      <image:title>Verdant Clean — Premium Cleaning Services in Lagos</image:title>
      <image:caption>A freshly cleaned Lagos apartment living room</image:caption>
    </image:image>
    <image:image>
      <image:loc>https://verdantclean.ng/images/service-home.jpg</image:loc>
      <image:title>Home Cleaning Service in Lagos</image:title>
    </image:image>
    <image:image>
      <image:loc>https://verdantclean.ng/images/service-office.jpg</image:loc>
      <image:title>Office Cleaning Service in Lagos</image:title>
    </image:image>
    <image:image>
      <image:loc>https://verdantclean.ng/images/service-shortstay.jpg</image:loc>
      <image:title>Short-Stay and Airbnb Turnover Cleaning in Lagos</image:title>
    </image:image>
    <image:image>
      <image:loc>https://verdantclean.ng/images/service-commercial.jpg</image:loc>
      <image:title>Commercial and Retail Cleaning in Lagos</image:title>
    </image:image>
    <image:image>
      <image:loc>https://verdantclean.ng/images/ba-kitchen.jpg</image:loc>
      <image:title>Deep-cleaned kitchen before and after</image:title>
    </image:image>
    <image:image>
      <image:loc>https://verdantclean.ng/images/ba-bathroom.jpg</image:loc>
      <image:title>Detailed bathroom clean before and after</image:title>
    </image:image>
  </url>
</urlset>
